# 複製此檔案為 secrets.toml，並填入自己的金鑰：
#   Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
# 真正的 secrets.toml 不可上傳到 Git、同步資料夾、截圖或聊天室。
# 若同時設定環境變數，OPENAI_API_KEY 與 OPENAI_MODEL 會優先使用環境變數。
OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"

# 可選：OPENAI_MODEL 是要呼叫的模型名稱；未設定時使用 gpt-5-mini。
# OPENAI_MODEL = "gpt-5-mini"
